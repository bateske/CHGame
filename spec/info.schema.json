{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bateske/CHGame/blob/main/spec/info.schema.json",
  "title": "CHGame .chgame info.json, schema version 1",
  "description": "The shape of a .chgame file's manifest (spec/chgame.md). Some rules are beyond a schema and only in chgame.md and tools/chcart: that named files exist, picture sizes and colours, SD paths across games, unique ids, the launch id naming a game. Unknown keys are allowed (readers warn and ignore them); keys beginning with x- are extensions (kept, not warned about).",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "games"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "$ref": "#/$defs/nonBlank"
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][0-9:.+\\-Z]+)?$"
    },
    "license": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "launch": {
      "type": "string"
    },
    "menu": {
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/$defs/path"
        },
        "cover": {
          "$ref": "#/$defs/path"
        },
        "about": {
          "$ref": "#/$defs/path"
        },
        "systemImages": {
          "type": "object",
          "description": "The visual menu's own screens, each a picture: SYSTEM.PIC's slots 1-8 (card.md step 7). Absent keys take the bundled defaults.",
          "properties": {
            "installed": {
              "$ref": "#/$defs/path"
            },
            "game": {
              "$ref": "#/$defs/path"
            },
            "folder": {
              "$ref": "#/$defs/path"
            },
            "error-1": {
              "$ref": "#/$defs/path"
            },
            "error-2": {
              "$ref": "#/$defs/path"
            },
            "error-3": {
              "$ref": "#/$defs/path"
            },
            "error-4": {
              "$ref": "#/$defs/path"
            },
            "error-5": {
              "$ref": "#/$defs/path"
            }
          }
        },
        "colors": {
          "type": "object",
          "properties": {
            "text": {
              "$ref": "#/$defs/color"
            },
            "disabled": {
              "$ref": "#/$defs/color"
            },
            "selectedText": {
              "$ref": "#/$defs/color"
            },
            "mark": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "folders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "background": {
                "$ref": "#/$defs/path"
              },
              "cover": {
                "$ref": "#/$defs/path"
              }
            }
          }
        }
      }
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/game"
      }
    }
  },
  "$defs": {
    "nonBlank": {
      "type": "string",
      "pattern": "\\S"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "game": {
      "type": "object",
      "required": [
        "id",
        "title",
        "binaries"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "title": {
          "type": "string",
          "pattern": "^(?=.*[^ ])[ -~]{1,31}$"
        },
        "folder": {
          "type": "string",
          "pattern": "^(|[!-.0-~](?:[ -.0-~]{0,17}[!-.0-~])?(?:/[!-.0-~](?:[ -.0-~]{0,17}[!-.0-~])?){0,3})$"
        },
        "version": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "genre": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "licenseFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "buttons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "control",
              "action"
            ],
            "properties": {
              "control": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "binaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "device",
              "filename"
            ],
            "properties": {
              "device": {
                "enum": [
                  "rev0"
                ]
              },
              "filename": {
                "$ref": "#/$defs/path"
              }
            }
          }
        },
        "sdcard": {
          "type": "string",
          "pattern": "/$"
        },
        "cartImage": {
          "$ref": "#/$defs/path"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "filename"
            ],
            "properties": {
              "filename": {
                "$ref": "#/$defs/path"
              },
              "title": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "patternProperties": {
    "^x-": {
      "description": "An extension: another tool's data, kept by writers, never an error. x-chgame-web version 1's systemImages are read as menu.systemImages (chgame.md, Extensions)."
    }
  }
}
